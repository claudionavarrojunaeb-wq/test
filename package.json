{
  "name": "excel-editor-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @excel-editor/api\" \"npm run dev -w @excel-editor/web\"",
    "dev:api": "npm run dev -w @excel-editor/api",
    "dev:web": "npm run dev -w @excel-editor/web",
    "build": "npm run build -w @excel-editor/api && npm run build -w @excel-editor/web"
  },
  "devDependencies": {
    "concurrently": "latest",
    "typescript": "^6.0.3"
  }
}
